{
    "name": "kommandhub/shipbubble-sw",
    "description": "Live courier rates from Shipbubble at checkout, shipment booking and tracking, on the merchant's own Shipbubble account.",
    "type": "shopware-platform-plugin",
    "version": "0.1.0",
    "license": "Apache-2.0",
    "keywords": [
        "shopware",
        "shopware6",
        "shopware-plugin",
        "shipbubble",
        "administration",
        "api-client",
        "custom-entity",
        "message-queue",
        "scheduled-task",
        "storefront",
        "webhooks"
    ],
    "homepage": "https://github.com/KommandHub-Org/KmhShipbubbleSW",
    "authors": [
        {
            "name": "Kommandhub Limited",
            "email": "admin@kommandhub.com",
            "homepage": "https://www.kommandhub.com",
            "role": "Developer"
        }
    ],
    "support": {
        "email": "admin@kommandhub.com",
        "issues": "https://github.com/KommandHub-Org/KmhShipbubbleSW/issues",
        "source": "https://github.com/KommandHub-Org/KmhShipbubbleSW",
        "docs": "https://github.com/KommandHub-Org/KmhShipbubbleSW/blob/main/README.md"
    },
    "require": {
        "php": ">=8.2",
        "shopware/core": "~6.7.0",
        "shopware/administration": "~6.7.0",
        "shopware/storefront": "~6.7.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5",
        "shopware/dev-tools": "^1.5",
        "friendsofphp/php-cs-fixer": "^3.94",
        "phpstan/phpstan": "^2.1",
        "rregeer/phpunit-coverage-check": "^0.3.1"
    },
    "autoload": {
        "psr-4": {
            "Kommandhub\\ShipbubbleSW\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Kommandhub\\ShipbubbleSW\\Tests\\": "tests/"
        }
    },
    "extra": {
        "shopware-plugin-class": "Kommandhub\\ShipbubbleSW\\KmhShipbubbleSW",
        "label": {
            "de-DE": "Shipbubble Kurierversand für Shopware 6",
            "en-GB": "Shipbubble Courier Delivery for Shopware 6",
            "fr-FR": "Shipbubble Courier Delivery for Shopware 6"
        },
        "description": {
            "de-DE": "Live-Kurierpreise von Shipbubble im Checkout, Sendungsbuchung und Sendungsverfolgung mit dem eigenen Shipbubble-Konto des Händlers.",
            "en-GB": "Live courier rates from Shipbubble at checkout, shipment booking and tracking, on the merchant's own Shipbubble account.",
            "fr-FR": "Live courier rates from Shipbubble at checkout, shipment booking and tracking, on the merchant's own Shipbubble account."
        },
        "manufacturerLink": {
            "de-DE": "https://www.kommandhub.com",
            "en-GB": "https://www.kommandhub.com"
        },
        "supportLink": {
            "de-DE": "https://www.kommandhub.com/support",
            "en-GB": "https://www.kommandhub.com/support"
        },
        "copyright": "(c) by Kommandhub Limited"
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true,
            "symfony/runtime": true
        },
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
