# Left out of the package Composer installs from Packagist (git archive).
# They only make sense in a checkout of this repository. `make zip` packs the
# working tree instead; its exclusions live in .shopware-extension.yml.
/.github                export-ignore
/tests                  export-ignore
/.dockerignore          export-ignore
/.editorconfig          export-ignore
/.gitattributes         export-ignore
/.gitignore             export-ignore
/.php-cs-fixer.dist.php export-ignore
/.prettierignore        export-ignore
/.prettierrc.json       export-ignore
/.shopware-extension.yml export-ignore
/CLAUDE.md              export-ignore
/CODE_OF_CONDUCT.md     export-ignore
/CONTRIBUTING.md        export-ignore
/Dockerfile             export-ignore
/Makefile               export-ignore
/docker-compose.yml     export-ignore
/phpcs.dist.xml         export-ignore
/phpstan.dist.neon      export-ignore
/phpunit.dist.xml       export-ignore
